---
// Gopher inline para os olhos poderem seguir o rato
const eyes = [
  { cx: 44, cy: 50 },
  { cx: 76, cy: 50 },
];
---

<svg
  class="gopher"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 120 120"
  width="110"
  height="110"
  role="img"
  aria-label="Gopher, a mascote do Go"
>
  <g stroke="#1b1b1b" stroke-width="3" stroke-linejoin="round">
    <circle cx="28" cy="32" r="10" fill="#6AD7E5"></circle>
    <circle cx="92" cy="32" r="10" fill="#6AD7E5"></circle>
    <rect x="20" y="20" width="80" height="112" rx="40" fill="#6AD7E5"></rect>
    {eyes.map((e) => <circle cx={e.cx} cy={e.cy} r="14" fill="#fff" />)}
    <ellipse cx="60" cy="71" rx="12" ry="8.5" fill="#F6D2A2"></ellipse>
    <rect x="55.5" y="77" width="9" height="8" rx="1.5" fill="#fff"></rect>
  </g>
  {
    eyes.map((e) => (
      <g class="pupil" data-cx={e.cx} data-cy={e.cy} transform="translate(4 2)">
        <circle cx={e.cx} cy={e.cy} r="5.5" fill="#1b1b1b" />
        <circle cx={e.cx + 1.8} cy={e.cy - 1.8} r="1.6" fill="#fff" />
      </g>
    ))
  }
  <ellipse cx="60" cy="66" rx="5.5" ry="3.8" fill="#1b1b1b"></ellipse>
</svg>

<script>
  const MAX = 6; // deslocamento máximo da pupila, em unidades do viewBox

  const svg = document.querySelector<SVGSVGElement>('.gopher');
  const pupils = svg ? [...svg.querySelectorAll<SVGGElement>('.pupil')] : [];

  window.addEventListener('pointermove', (ev) => {
    if (!svg) return;
    const box = svg.getBoundingClientRect();
    const scale = box.width / 120;

    for (const p of pupils) {
      const ex = box.left + Number(p.dataset.cx) * scale;
      const ey = box.top + Number(p.dataset.cy) * scale;
      const dx = ev.clientX - ex;
      const dy = ev.clientY - ey;
      const dist = Math.hypot(dx, dy);
      const r = Math.min(MAX, dist / (scale * 8));
      const x = dist ? (dx / dist) * r : 0;
      const y = dist ? (dy / dist) * r : 0;
      p.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
    }
  });
</script>
