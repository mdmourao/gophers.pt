---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = new Intl.DateTimeFormat('pt-PT', { dateStyle: 'long' });
---

<BlogLayout
  title="Blog — Gophers Portugal"
  description="Artigos, tutoriais e resumos de meetups da comunidade de Go (Golang) em Portugal."
>
  <p class="cmd"><span class="prompt">$</span> go list ./blog/...</p>
  <h1>Blog</h1>
  <p class="lead">Artigos, tutoriais e resumos de meetups, escritos pela comunidade.</p>

  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="post">
            <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BlogLayout>

<style>
  .cmd {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .prompt {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .lead {
    color: var(--muted);
    margin: 0 0 2.5rem;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .post {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post:hover h2 {
    color: var(--accent-strong);
  }

  time {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  h2 {
    font-size: 1.15rem;
    margin: 0.25rem 0 0.35rem;
  }

  .post p {
    margin: 0;
    color: var(--muted);
  }
</style>
