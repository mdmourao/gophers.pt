---
import Layout from '../layouts/Layout.astro';
import Gopher from '../components/Gopher.astro';

const links = [
  { label: 'Meetup', note: 'Junta-te agora', href: 'https://www.meetup.com/gophers-portugal/' },
  { label: 'Blog', note: 'Ler artigos', href: '/blog/' },
  { label: 'Discord', note: 'Entrar no servidor', href: 'https://discord.gg/qKQe9HCrK4' },
];
---

<Layout
  title="Gophers Portugal — Comunidade de Go (Golang) em Portugal"
  description="A comunidade de developers de Go (Golang) em Portugal. Meetups, talks e partilha de ideias entre programadores Go em Lisboa, Porto e todo o país."
>
  <main class="page">
    <div class="stack">
    <div class="mascot"><Gopher /></div>
    <div class="frame">
      <span class="corner tl"></span>
      <span class="corner tr"></span>
      <span class="corner bl"></span>
      <span class="corner br"></span>

      <p class="cmd"><span class="prompt">$</span> go run portugal.go</p>
      <h1>Gophers Portugal</h1>
      <p class="lead">A comunidade de Go em Portugal. Junta-te, partilha ideias, conhece outros developers.</p>

      <ul class="links">
        {
          links.map((l) =>
            l.href ? (
              <li>
                <a
                  href={l.href}
                  class="row"
                  {...(l.href.startsWith('http') && { target: '_blank', rel: 'noopener' })}
                >
                  <span>{l.label}</span>
                  <span class="note">
                    {l.note} <span class="arrow">→</span>
                  </span>
                </a>
              </li>
            ) : (
              <li class="row soon">
                <span>{l.label}</span>
                <span class="pill">{l.note}</span>
              </li>
            ),
          )
        }
      </ul>
    </div>
    </div>

    <footer>
      © {new Date().getFullYear()} Gophers Portugal · Gopher inspirado no original de
      <a href="https://reneefrench.blogspot.com/" target="_blank" rel="noopener">Renée French</a> (CC BY 4.0)
      <br />
      Criado por
      <a href="https://mdmourao.com/" target="_blank" rel="noopener">mdmourao</a>
      (<a href="https://x.com/mdmourao" target="_blank" rel="noopener">@mdmourao</a>)
    </footer>
  </main>
</Layout>

<style>
  .page {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem 1rem;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 560px;
  }

  .mascot {
    display: flex;
    position: relative;
    z-index: 0;
    margin-bottom: -34px;
  }

  .frame {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 560px;
    padding: 2.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }

  .tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
  .tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
  .bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
  .br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

  .cmd {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .prompt {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .lead {
    color: var(--muted);
    margin: 0 0 2rem;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    font-weight: 500;
  }

  a.row:hover {
    color: var(--accent-strong);
  }

  .note {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }

  a.row:hover .arrow {
    transform: translateX(3px);
  }

  .soon > span:first-child {
    color: var(--muted);
  }

  .pill {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    border: 1px dashed var(--border);
    border-radius: 999px;
    color: var(--muted);
  }

  footer {
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }

  footer a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 480px) {
    .frame {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
