{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gophers-portugal",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "gophers.pt", "custom_domain": true },
    { "pattern": "www.gophers.pt", "custom_domain": true }
  ]
}
